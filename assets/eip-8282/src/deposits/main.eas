;;  █████╗ ██████╗  █████╗ ██████╗   █████╗ ███████╗███╗   ███╗
;; ██╔══██╗╚════██╗██╔══██╗╚════██╗ ██╔══██╗██╔════╝████╗ ████║
;; ╚█████╔╝ █████╔╝╚█████╔╝ █████╔╝ ███████║███████╗██╔████╔██║
;; ██╔══██╗██╔═══╝ ██╔══██╗██╔═══╝  ██╔══██║╚════██║██║╚██╔╝██║
;; ╚█████╔╝███████╗╚█████╔╝███████╗ ██║  ██║███████║██║ ╚═╝ ██║
;;  ╚════╝ ╚══════╝ ╚════╝ ╚══════╝ ╚═╝  ╚═╝╚══════╝╚═╝     ╚═╝
;;
;; This is an implementation of the EIP-8282 builder deposit request contract.
;; It is copied from the EIP-7002 withdrawals contract (the same code skeleton
;; the EIP-7251 consolidations contract uses); the fee mechanism, the queue
;; design, and the subroutines logic of the original smart contract remain.
;;
;; The differences from the EIP-7002 smart contract are:
;;
;;   * input data and the size of the queue item: the input is a 184-byte
;;     deposit (pubkey ++ withdrawal_credentials ++ amount ++ signature, with
;;     the amount a big-endian uint64 of gwei) and the record carries no
;;     source address, so the record equals the input with the amount
;;     converted to little-endian on the read path (the same conversion, and
;;     the same macro, the EIP-7002 contract uses for its amount);
;;   * two added checks on the write path: the amount must be at least
;;     MIN_AMOUNT, and the call value must cover amount * 1 gwei of stake on
;;     top of the request fee.

#pragma target "prague"

;; ----------------------------------------------------------------------------
;; CONSTANTS ------------------------------------------------------------------
;; ----------------------------------------------------------------------------

#define SYSTEM_ADDR = .address(0xfffffffffffffffffffffffffffffffffffffffe)

#define SLOT_EXCESS = 0    ;; pre-fork inhibitor flag (EXCESS_INHIBITOR until the first system call)

#define QUEUE_HEAD = 2
#define QUEUE_TAIL = 3
#define QUEUE_OFFSET = 4

#define MIN_FEE = 1
#define MAX_PER_BLOCK = 16        ;; default per-block dequeue limit (used when the system call passes no limit)
#define HARD_MAX_PER_BLOCK = 8192 ;; absolute ceiling the system-call-supplied limit is clamped to
#define FEE_UPDATE_FRACTION = 17
#define EXCESS_INHIBITOR = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

#define MIN_AMOUNT = 1000000000 ;; minimum deposit amount in gwei (1 ETH, the EIP-7732 builder minimum)
#define GWEI = 1000000000       ;; wei per gwei

#define INPUT_SIZE = 184   ;; submitter input: (pubkey ++ withdrawal_credentials ++ amount ++ signature)
;; The dequeued record appends an 8-byte enqueue block timestamp (little-endian,
;; like the amount), fitting the 6th storage slot's previously-zero trailing 8
;; bytes; no extra storage slot is needed, only the returned record grows.
#define RECORD_SIZE = 192  ;; INPUT_SIZE + 8-byte enqueue timestamp
#define SLOTS_PER_ITEM = 6 ;; (pk[0:32], pk[32:48]+wc[0:16], wc[16:32]+amount+sig[0:8], sig[8:40], sig[40:72], sig[72:96]+timestamp)

;; ----------------------------------------------------------------------------
;; PROGRAM START --------------------------------------------------------------
;; ----------------------------------------------------------------------------

  ;; Protect the system subroutine by checking if the caller is the system
  ;; address.
  caller                ;; [caller]
  push SYSTEM_ADDR      ;; [sysaddr, caller]
  eq                    ;; [sysaddr == caller]
  jumpi @read_requests  ;; []

  ;; --------------------------------------------------------------------------
  ;; USER SUBROUTINE ----------------------------------------------------------
  ;; --------------------------------------------------------------------------

  ;; Check if the pre-fork inhibitor is still active, revert if so.
  push SLOT_EXCESS      ;; [flag_slot]
  sload                 ;; [flag]
  push EXCESS_INHIBITOR ;; [inhibitor, flag]
  eq                    ;; [inhibitor == flag]
  jumpi @revert         ;; []

  ;; Compute the fee per-tx from the current queue length (tail - head): a
  ;; longer backlog costs more, priced from the live queue depth at deposit time.
  push FEE_UPDATE_FRACTION ;; [update_fraction]
  push QUEUE_HEAD       ;; [head_slot, update_fraction]
  sload                 ;; [head, update_fraction]
  push QUEUE_TAIL       ;; [tail_slot, head, update_fraction]
  sload                 ;; [tail, head, update_fraction]
  sub                   ;; [qlen, update_fraction]
  push MIN_FEE          ;; [min_fee, qlen, update_fraction]
  #include "../common/fake_expo.eas"

  ;; If calldatasize matches the expected input size, go to adding the request.
  calldatasize          ;; [calldatasize, req_fee]
  push INPUT_SIZE       ;; [INPUT_SIZE, calldatasize, req_fee]
  eq                    ;; [INPUT_SIZE == calldatasize, req_fee]
  jumpi @handle_input   ;; [req_fee]

  ;; Otherwise calldatasize must be zero.
  calldatasize          ;; [calldatasize, req_fee]
  jumpi @revert         ;; [req_fee]

  ;; This is the read path, where we return the current fee.
  ;; Reject any callvalue here to prevent lost funds.
  callvalue             ;; [value, req_fee]
  jumpi @revert         ;; [req_fee]

  ;; Return req_fee.
  push 0                ;; [0, req_fee]
  mstore                ;; []
  push 32               ;; [32]
  push 0                ;; [0, 32]
  return                ;; []

handle_input:
  ;; This is the write path. We expect the computed fee on the stack.
  ;; Input data has the following layout:
  ;;
  ;;  +--------+------------------------+--------+-----------+
  ;;  | pubkey | withdrawal_credentials | amount | signature |
  ;;  +--------+------------------------+--------+-----------+
  ;;      48               32                8         96
  ;;
  ;; The amount is a big-endian uint64 of gwei.

  ;; Determine if the value provided is enough to cover the deposit request
  ;; fee. Keep a copy of the fee for the stake check below.
  dup1                  ;; [req_fee, req_fee]
  callvalue             ;; [callvalue, req_fee, req_fee]
  lt                    ;; [callvalue < req_fee, req_fee]
  jumpi @revert         ;; [req_fee]

  ;; Load the big-endian uint64 amount from input[80:88].
  push 56               ;; [56, req_fee]
  calldataload          ;; [input[56:88], req_fee]
  push uint64_mask      ;; [mask, input[56:88], req_fee]
  and                   ;; [amount, req_fee]

  ;; Determine if the amount is at least the minimum deposit amount.
  dup1                  ;; [amount, amount, req_fee]
  push MIN_AMOUNT       ;; [min_amount, amount, amount, req_fee]
  gt                    ;; [min_amount > amount, amount, req_fee]
  jumpi @revert         ;; [amount, req_fee]

  ;; Determine if the value provided beyond the fee covers the stake, i.e.
  ;; callvalue - req_fee >= amount * 1 gwei. The subtraction cannot underflow
  ;; (the fee check above passed) and the multiplication cannot overflow
  ;; (amount < 2**64).
  push GWEI             ;; [gwei, amount, req_fee]
  mul                   ;; [amount_wei, req_fee]
  swap1                 ;; [req_fee, amount_wei]
  callvalue             ;; [callvalue, req_fee, amount_wei]
  sub                   ;; [callvalue-req_fee, amount_wei]
  lt                    ;; [callvalue-req_fee < amount_wei]
  jumpi @revert         ;; []

  ;; The request can pay.

  ;; Now insert request into queue. First, compute the base storage slot
  push QUEUE_TAIL       ;; [tail_idx_slot]
  sload                 ;; [tail_idx]
  dup1                  ;; [tail_idx, tail_idx]
  push SLOTS_PER_ITEM   ;; [slots, tail_idx, tail_idx]
  mul                   ;; [slots*tail_idx, tail_idx]
  push QUEUE_OFFSET     ;; [ost, slots*tail_idx, tail_idx]
  add                   ;; [slot, tail_idx]

  ;; Store pk[0:32] to queue.
  push 0                ;; [0, slot, ..]
  calldataload          ;; [pk[0:32], slot, ..]
  dup2                  ;; [slot, pk[0:32], slot, ..]
  sstore                ;; [slot, ..]

  push 1                ;; [1, slot, ..]
  add                   ;; [slot, ..]

  ;; Store pk[32:48] ++ wc[0:16] to queue.
  push 32               ;; [32, slot, ..]
  calldataload          ;; [pk[32:48] ++ wc[0:16], slot, ..]
  dup2                  ;; [slot, pk[32:48] ++ wc[0:16], slot, ..]
  sstore                ;; [slot, ..]

  push 1                ;; [1, slot, ..]
  add                   ;; [slot, ..]

  ;; Store wc[16:32] ++ amount ++ sig[0:8] to queue. The amount is stored
  ;; big-endian, exactly as submitted; the read path converts it.
  push 64               ;; [64, slot, ..]
  calldataload          ;; [wc[16:32] ++ amount ++ sig[0:8], slot, ..]
  dup2                  ;; [slot, wc[16:32] ++ amount ++ sig[0:8], slot, ..]
  sstore                ;; [slot, ..]

  push 1                ;; [1, slot, ..]
  add                   ;; [slot, ..]

  ;; Store sig[8:40] to queue.
  push 96               ;; [96, slot, ..]
  calldataload          ;; [sig[8:40], slot, ..]
  dup2                  ;; [slot, sig[8:40], slot, ..]
  sstore                ;; [slot, ..]

  push 1                ;; [1, slot, ..]
  add                   ;; [slot, ..]

  ;; Store sig[40:72] to queue.
  push 128              ;; [128, slot, ..]
  calldataload          ;; [sig[40:72], slot, ..]
  dup2                  ;; [slot, sig[40:72], slot, ..]
  sstore                ;; [slot, ..]

  push 1                ;; [1, slot, ..]
  add                   ;; [slot, ..]

  ;; Store sig[72:96] ++ enqueue timestamp to queue. The calldataload reads 8
  ;; bytes past the 184-byte input, so the low 8 bytes are zero; OR the enqueue
  ;; block timestamp (a uint64, so it cannot collide with the signature bytes)
  ;; into them. The read path returns it little-endian (matching the amount).
  push 160              ;; [160, slot, ..]
  calldataload          ;; [sig[72:96], slot, ..]   (low 8 bytes = 0)
  timestamp             ;; [ts, sig[72:96], slot, ..]
  or                    ;; [sig[72:96]|ts, slot, ..]
  swap1                 ;; [slot, sig[72:96]|ts, ..]
  sstore                ;; [..]

  ;; Assemble log data: the input verbatim (the amount big-endian, as
  ;; submitted). The enqueue event logs only the submitter's input.
  push INPUT_SIZE       ;; [size, ..]
  push 0                ;; [ost, size, ..]
  push 0                ;; [dest, ost, size, ..]
  calldatacopy          ;; [..]

  ;; Log record (the verbatim INPUT_SIZE input).
  push INPUT_SIZE       ;; [size, ..]
  push 0                ;; [idx, size, ..]
  log0                  ;; [..]

  ;; Increment queue tail over last and write to storage.
  push 1                ;; [1, tail_idx]
  add                   ;; [tail_idx+1]
  push QUEUE_TAIL       ;; [tail_idx_slot, tail_idx+1]
  sstore                ;; []

  stop

;; ----------------------------------------------------------------------------
;; SYSTEM SUBROUTINE ----------------------------------------------------------
;; ----------------------------------------------------------------------------
;;
;; Pop requests from the queue. This is the logic executed by the protocol each
;; block. It reads as many requests as available from the queue, up to a
;; per-block limit supplied by the system call (clamped to HARD_MAX_PER_BLOCK),
;; or MAX_PER_BLOCK when no limit is supplied. The requests are returned as a
;; contiguous array of bytes with each record being exactly RECORD_SIZE bytes.
;;
;;  Deposit request record:
;;
;;  +--------+------------------------+--------+-----------+
;;  | pubkey | withdrawal_credentials | amount | signature |
;;  +--------+------------------------+--------+-----------+
;;      48               32                8         96
;;
;; The amount is returned little-endian (the SSZ encoding the consensus layer
;; decodes), converted from the big-endian value submitted on the write path.
;;
;; Because the requests are stored across SLOTS_PER_ITEM storage slots, there
;; is some shuffling to align the data.
;;
;; After reading the requests, they are removed from the queue by modifying the
;; queue's head index.
read_requests:
  ;; Determine the per-block dequeue limit. The end-of-block system call MAY pass
  ;; a 32-byte limit as calldata; otherwise the default MAX_PER_BLOCK is used.
  ;; The supplied limit is clamped to HARD_MAX_PER_BLOCK so a block can never be
  ;; asked to drain (and the consensus layer to verify) an unbounded number of
  ;; records.
  push 32               ;; [32]
  calldatasize          ;; [cds, 32]
  lt                    ;; [cds < 32]
  jumpi @default_limit  ;; []

  push 0                ;; [0]
  calldataload          ;; [cd_limit]
  dup1                  ;; [cd_limit, cd_limit]
  push HARD_MAX_PER_BLOCK ;; [hard_max, cd_limit, cd_limit]
  lt                    ;; [hard_max < cd_limit, cd_limit]
  jumpi @clamp_limit    ;; [cd_limit]
  jump @have_limit      ;; [cd_limit]

clamp_limit:
  pop                   ;; []
  push HARD_MAX_PER_BLOCK ;; [hard_max]
  jump @have_limit      ;; [limit]

default_limit:
  push MAX_PER_BLOCK    ;; [limit]

have_limit:
  ;; [limit] -- drain min(tail - head, limit) records, oldest first.
  push QUEUE_HEAD       ;; [head_slot, limit]
  sload                 ;; [head, limit]
  push QUEUE_TAIL       ;; [tail_slot, head, limit]
  sload                 ;; [tail, head, limit]

  ;; count = tail - head
  dup2                  ;; [head, tail, head, limit]
  dup2                  ;; [tail, head, tail, head, limit]
  sub                   ;; [count, tail, head, limit]

  ;; drain = min(count, limit)
  dup4                  ;; [limit, count, tail, head, limit]
  dup2                  ;; [count, limit, count, tail, head, limit]
  gt                    ;; [count > limit, count, tail, head, limit]
  jumpi @drain_limit    ;; [count, tail, head, limit]

  ;; count <= limit: drain the whole queue. Produce [count, head_idx, tail_idx].
  swap3                 ;; [limit, tail, head, count]
  pop                   ;; [tail, head, count]
  swap2                 ;; [count, head, tail]
  jump @begin_loop

drain_limit:
  ;; count > limit: drain exactly the limit. Produce [limit, head_idx, tail_idx].
  pop                   ;; [tail, head, limit]
  swap2                 ;; [limit, head, tail]

begin_loop:
  push 0                ;; [i, count, head_idx, tail_idx]

accum_loop:
  ;; This loop will read each request and byte bang it into a RECORD_SIZE byte
  ;; chunk.

  ;; Bounds check, ensure i < count.
  dup2                  ;; [count, i, count, head_idx, tail_idx]
  dup2                  ;; [i, count, i, count, head_idx, tail_idx]
  eq                    ;; [i == count, i, count, head_idx, tail_idx]
  jumpi @update_head    ;; [i, count, head_idx, tail_idx]

  ;; Determine the base storage slot for this iteration. The base slot will be
  ;; (queue_offset + (queue_head + i)*6).
  dup3                  ;; [head_idx, i, ..]
  dup2                  ;; [i, head_idx, i, ..]
  add                   ;; [i+head_idx, i, ..]
  push SLOTS_PER_ITEM   ;; [6, i+head_idx, i, ..]
  mul                   ;; [6*(i+head_idx), i, ..]
  push QUEUE_OFFSET     ;; [offset, 6*(i+head_idx), i, ..]
  add                   ;; [slotbase, i, ..]

  ;; Write values to memory flat and contiguously. The record equals the six
  ;; storage words written back to back, except that the amount (record bytes
  ;; 80..88, stored big-endian in the middle of the third word) is re-stored
  ;; little-endian.
  ;;
  ;; The slots have the following layout:
  ;;
  ;; 0: pk[0:32] -> pk1
  ;;  0x00 | bb bb bb bb bb bb bb bb bb bb bb bb bb bb bb bb
  ;;  0x10 | bb bb bb bb bb bb bb bb bb bb bb bb bb bb bb bb
  ;;
  ;; 1: pk[32:48] ++ wc[0:16] -> pk2_wc1
  ;;  0x00 | bb bb bb bb bb bb bb bb bb bb bb bb bb bb bb bb
  ;;  0x10 | cc cc cc cc cc cc cc cc cc cc cc cc cc cc cc cc
  ;;
  ;; 2: wc[16:32] ++ amount ++ sig[0:8] -> wc2_am_sg1
  ;;  0x00 | cc cc cc cc cc cc cc cc cc cc cc cc cc cc cc cc
  ;;  0x10 | dd dd dd dd dd dd dd dd ee ee ee ee ee ee ee ee
  ;;
  ;; 3: sig[8:40] -> sg2
  ;;  0x00 | ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee
  ;;  0x10 | ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee
  ;;
  ;; 4: sig[40:72] -> sg3
  ;;  0x00 | ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee
  ;;  0x10 | ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee
  ;;
  ;; 5: sig[72:96] -> sg4
  ;;  0x00 | ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee
  ;;  0x10 | ee ee ee ee ee ee ee ee 00 00 00 00 00 00 00 00

  ;; Compute the output offset = i*RECORD_SIZE.
  dup2                  ;; [i, slotbase, i, ..]
  push RECORD_SIZE      ;; [size, i, slotbase, i, ..]
  mul                   ;; [offset=size*i, slotbase, i, ..]

  ;; Read slot 'pk1' from storage.
  dup2                  ;; [slotbase, offset, slotbase, ..]
  sload                 ;; [pk1, offset, slotbase, ..]

  ;; Store pk1 at output offset = i*RECORD_SIZE.
  dup2                  ;; [offset, pk1, offset, slotbase, ..]
  mstore                ;; [offset, slotbase, ..]
  push 32               ;; [32, offset, slotbase, ..]
  add                   ;; [offset=offset+32, slotbase, ..]

  ;; Read slot 'pk2_wc1' from storage.
  dup2                  ;; [slotbase, offset, slotbase, ..]
  push 1                ;; [1, slotbase, offset, slotbase, ..]
  add                   ;; [slot, offset, slotbase, ..]
  sload                 ;; [pk2_wc1, offset, slotbase, ..]

  ;; Store pk2_wc1 at output offset = i*RECORD_SIZE + 32.
  dup2                  ;; [offset, pk2_wc1, offset, slotbase, ..]
  mstore                ;; [offset, slotbase, ..]
  push 32               ;; [32, offset, slotbase, ..]
  add                   ;; [offset=offset+64, slotbase, ..]

  ;; Read slot 'wc2_am_sg1' from storage.
  dup2                  ;; [slotbase, offset, slotbase, ..]
  push 2                ;; [2, slotbase, offset, slotbase, ..]
  add                   ;; [slot, offset, slotbase, ..]
  sload                 ;; [wc2_am_sg1, offset, slotbase, ..]

  ;; Store wc2_am_sg1 at output offset = i*RECORD_SIZE + 64 (the amount still
  ;; big-endian; it is overwritten little-endian just below).
  dup1                  ;; [wc2_am_sg1, wc2_am_sg1, offset, slotbase, ..]
  dup3                  ;; [offset, wc2_am_sg1, wc2_am_sg1, offset, slotbase, ..]
  mstore                ;; [wc2_am_sg1, offset, slotbase, ..]

  ;; Extract am from wc2_am_sg1.
  push 8*8              ;; [shft, wc2_am_sg1, offset, slotbase, ..]
  shr                   ;; [wc2_am, offset, slotbase, ..]
  push uint64_mask      ;; [mask, wc2_am, offset, slotbase, ..]
  and                   ;; [am, offset, slotbase, ..]

  ;; Store am at output offset = i*RECORD_SIZE + 80.
  ;; Note we convert to little-endian.
  dup2                  ;; [offset, am, offset, slotbase, ..]
  push 16               ;; [16, offset, am, offset, slotbase, ..]
  add                   ;; [offset+16, am, offset, slotbase, ..]
  %mstore_uint64_le()   ;; [offset, slotbase, ..]

  push 32               ;; [32, offset, slotbase, ..]
  add                   ;; [offset=offset+96, slotbase, ..]

  ;; Read slot 'sg2' from storage.
  dup2                  ;; [slotbase, offset, slotbase, ..]
  push 3                ;; [3, slotbase, offset, slotbase, ..]
  add                   ;; [slot, offset, slotbase, ..]
  sload                 ;; [sg2, offset, slotbase, ..]

  ;; Store sg2 at output offset = i*RECORD_SIZE + 96.
  dup2                  ;; [offset, sg2, offset, slotbase, ..]
  mstore                ;; [offset, slotbase, ..]
  push 32               ;; [32, offset, slotbase, ..]
  add                   ;; [offset=offset+128, slotbase, ..]

  ;; Read slot 'sg3' from storage.
  dup2                  ;; [slotbase, offset, slotbase, ..]
  push 4                ;; [4, slotbase, offset, slotbase, ..]
  add                   ;; [slot, offset, slotbase, ..]
  sload                 ;; [sg3, offset, slotbase, ..]

  ;; Store sg3 at output offset = i*RECORD_SIZE + 128.
  dup2                  ;; [offset, sg3, offset, slotbase, ..]
  mstore                ;; [offset, slotbase, ..]
  push 32               ;; [32, offset, slotbase, ..]
  add                   ;; [offset=offset+160, slotbase, ..]

  ;; Read slot 'sg4' = sig[72:96] (high 24 bytes) ++ enqueue timestamp (low 8
  ;; bytes, stored big-endian on the write path).
  swap1                 ;; [slotbase, offset, ..]
  push 5                ;; [5, slotbase, offset, ..]
  add                   ;; [slot, offset, ..]
  sload                 ;; [sg4, offset, ..]

  ;; Store the full sg4 word at output offset = i*RECORD_SIZE + 160 (lays down
  ;; sig[72:96] and the big-endian timestamp in the trailing 8 bytes).
  dup1                  ;; [sg4, sg4, offset, ..]
  dup3                  ;; [offset, sg4, sg4, offset, ..]
  mstore                ;; [sg4, offset, ..]

  ;; Overwrite the trailing 8 bytes (offset+184) with the timestamp little-endian,
  ;; matching the SSZ encoding used for the amount.
  push uint64_mask      ;; [mask, sg4, offset, ..]
  and                   ;; [ts, offset, ..]
  swap1                 ;; [offset, ts, ..]
  push 24               ;; [24, offset, ts, ..]   (160 + 24 = 184)
  add                   ;; [offset+184, ts, ..]
  %mstore_uint64_le()   ;; [..]

  ;; Increment i.
  push 1                ;; [1, i, ..]
  add                   ;; [i+1, ..]

  jump @accum_loop      ;; [i, count, head_idx, tail_idx]

update_head:
  ;; All requests have been read, update queue by adding the count read to the
  ;; current head index.
  swap2                 ;; [head_idx, count, count, tail_idx]
  add                   ;; [new_head_idx, count, tail_idx]

  ;; If the new head is equal to the tail, reset the queue by zeroing them both.
  dup1                  ;; [new_head_idx, new_head_idx, count, tail_idx]
  swap3                 ;; [tail_idx, new_head_idx, count, new_head_idx]
  eq                    ;; [new_head_idx == tail_idx, count, new_head_idx]
  jumpi @reset_queue    ;; [count, new_head_idx]

  ;; Otherwise, write the new head to storage.
  swap1                 ;; [new_head_idx, count]
  push QUEUE_HEAD       ;; [head_idx_slot, new_head_idx, count]
  sstore                ;; [count]

  jump @update_excess   ;; [count]

reset_queue:
  ;; Since the queue is empty, both the head and tail indexes can be zeroed.
  swap1                 ;; [new_head_idx, count]
  pop                   ;; [count]

  push 0                ;; [0, count]
  push QUEUE_HEAD       ;; [head_slot, 0, count]
  sstore                ;; [count]

  push 0                ;; [0, count]
  push QUEUE_TAIL       ;; [tail_slot, 0, count]
  sstore                ;; [count]

update_excess:
  ;; [count]
  ;; No per-block excess to accumulate (the fee is per-tx from the queue length).
  ;; Clear the inhibitor on the first system call so the user path becomes live.
  push SLOT_EXCESS      ;; [flag_slot, count]
  sload                 ;; [flag, count]
  push EXCESS_INHIBITOR ;; [inhibitor, flag, count]
  eq                    ;; [flag == inhibitor, count]
  iszero                ;; [flag != inhibitor, count]
  jumpi @do_return      ;; [count]
  push 0                ;; [0, count]
  push SLOT_EXCESS      ;; [flag_slot, 0, count]
  sstore                ;; [count]

do_return:
  ;; Return the requests: count * RECORD_SIZE bytes from memory offset 0.
  push RECORD_SIZE      ;; [record_size, count]
  mul                   ;; [size]
  push 0                ;; [0, size]
  return                ;; []

;; Revert subroutine.
revert:
  push 0
  push 0
  revert

;; ----------------------------------------------------------------------------
;; MACROS ---------------------------------------------------------------------
;; ----------------------------------------------------------------------------

;; This defines a mask for accessing the low 8 bytes of a number.
#define uint64_mask = 0xffffffffffffffff

;; Helper for storing little-endian amount.
#define %mstore_uint64_le() { ;; [offset, value]
  dup2                  ;; [value, offset, value]
  push 7*8              ;; [56, value, offset, value]
  shr                   ;; [value>>56, offset, value]
  dup2                  ;; [offset, value>>56, offset, value]
  push 7                ;; [7, offset, value>>56, offset, value]
  add                   ;; [offset+7, value>>56, offset, value]
  mstore8               ;; [offset, value]

  dup2                  ;; [value, offset, value]
  push 6*8              ;; [48, value, offset, value]
  shr                   ;; [value>>48, offset, value]
  dup2                  ;; [offset, value>>48, offset, value]
  push 6                ;; [6, offset, value>>48, offset, value]
  add                   ;; [offset+6, value>>48, offset, value]
  mstore8               ;; [offset, value]

  dup2                  ;; [value, offset, value]
  push 5*8              ;; [40, value, offset, value]
  shr                   ;; [value>>40, offset, value]
  dup2                  ;; [offset, value>>40, offset, value]
  push 5                ;; [5, offset, value>>40, offset, value]
  add                   ;; [offset+5, value>>40, offset, value]
  mstore8               ;; [offset, value]

  dup2                  ;; [value, offset, value]
  push 4*8              ;; [32, value, offset, value]
  shr                   ;; [value>>32, offset, value]
  dup2                  ;; [offset, value>>32, offset, value]
  push 4                ;; [4, offset, value>>32, offset, value]
  add                   ;; [offset+4, value>>32, offset, value]
  mstore8               ;; [offset, value]

  dup2                  ;; [value, offset, value]
  push 3*8              ;; [24, value, offset, value]
  shr                   ;; [value>>24, offset, value]
  dup2                  ;; [offset, value>>24, offset, value]
  push 3                ;; [3, offset, value>>24, offset, value]
  add                   ;; [offset+3, value>>24, offset, value]
  mstore8               ;; [offset, value]

  dup2                  ;; [value, offset, value]
  push 2*8              ;; [16, value, offset, value]
  shr                   ;; [value>>16, offset, value]
  dup2                  ;; [offset, value>>16, offset, value]
  push 2                ;; [2, offset, value>>16, offset, value]
  add                   ;; [offset+2, value>>16, offset, value]
  mstore8               ;; [offset, value]

  dup2                  ;; [value, offset, value]
  push 1*8              ;; [8, value, offset, value]
  shr                   ;; [value>>8, offset, value]
  dup2                  ;; [offset, value>>8, offset, value]
  push 1                ;; [1, offset, value>>8, offset, value]
  add                   ;; [offset+1, value>>8, offset, value]
  mstore8               ;; [offset, value]

  mstore8               ;; []
}
