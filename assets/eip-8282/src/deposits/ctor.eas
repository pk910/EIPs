  ;; No pre-fork inhibitor: builders may deposit before the fork, so the
  ;; constructor stores no inhibitor value and only installs the runtime code.

  ;; Copy and return code.
  push len(code)     ; [len]
  dup1               ; [len, len]
  push @code         ; [codeOffset, len, len]
  push 0             ; [dest, codeOffset, len, len]
  codecopy           ; [len]
  push 0             ; [ptr, len]
  return             ; []

#bytes code: assemble("main.eas")
